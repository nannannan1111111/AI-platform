#cloud-config
package_update: true
package_upgrade: true

packages:
  - ca-certificates
  - curl
  - docker.io
  - docker-compose-v2
  - jq

write_files:
  - path: /usr/sbin/policy-rc.d
    owner: root:root
    permissions: "0755"
    content: |
      #!/bin/sh
      exit 101

  - path: /usr/local/sbin/infinite-canvas-mount-data
    owner: root:root
    permissions: "0750"
    content: |
      #!/usr/bin/env bash
      set -euo pipefail

      device="${media_disk_device}"
      mount_path="/srv/infinite-canvas"

      if [[ ! -b "$device" ]]; then
        echo "waiting for encrypted CBS device $device" >&2
        exit 1
      fi

      if ! blkid "$device" >/dev/null 2>&1; then
        mkfs.ext4 -F -L infinite-canvas-data "$device"
      fi

      filesystem_uuid="$(blkid -s UUID -o value "$device")"
      install -d -o root -g root -m 0755 "$mount_path"
      if ! grep -q "UUID=$filesystem_uuid " /etc/fstab; then
        echo "UUID=$filesystem_uuid $mount_path ext4 defaults,nofail,nodev,nosuid 0 2" >> /etc/fstab
      fi
      mount "$mount_path" || mount -a

      mount_source="$(findmnt -n -o SOURCE --target "$mount_path")"
      if [[ "$mount_source" != "$device" && "$mount_source" != "/dev/disk/by-uuid/$filesystem_uuid" ]]; then
        echo "unexpected mount source $mount_source for $mount_path" >&2
        exit 1
      fi

      install -d -o 10001 -g 10001 -m 0750 "$mount_path/data/generated-media"
      install -d -o 10001 -g 10001 -m 0700 "$mount_path/secrets/providers"
      install -d -o root -g root -m 0750 /etc/infinite-canvas
      install -d -o root -g root -m 0755 /opt/infinite-canvas

  - path: /etc/systemd/system/infinite-canvas-data.service
    owner: root:root
    permissions: "0644"
    content: |
      [Unit]
      Description=Mount and prepare the Infinite Canvas encrypted data disk
      After=local-fs.target
      StartLimitIntervalSec=0

      [Service]
      Type=oneshot
      ExecStart=/usr/local/sbin/infinite-canvas-mount-data
      RemainAfterExit=yes
      Restart=on-failure
      RestartSec=15

      [Install]
      WantedBy=multi-user.target

runcmd:
  - [curl, --fail, --silent, --show-error, --location, --output, /tmp/caddy.deb, "https://github.com/caddyserver/caddy/releases/download/v2.11.4/caddy_2.11.4_linux_amd64.deb"]
  - [bash, -c, "echo '1c6f5404f3622e46d401d81f4af59677d46b886229c6694d60fd936b87c72d3bb5d1fcf42b55c8d555769fa75acf434ab618fc7e0df2c79cf8512ee580d38d06  /tmp/caddy.deb' | sha512sum --check --strict"]
  - [dpkg, --install, /tmp/caddy.deb]
  - [curl, --fail, --silent, --show-error, --location, --output, /usr/local/bin/cosign, "https://github.com/sigstore/cosign/releases/download/v3.1.3/cosign-linux-amd64"]
  - [bash, -c, "echo '4629c757b7618056f8ddd7e2625ae9fdd94c0372a65049520bc7d9df9efc7f71  /usr/local/bin/cosign' | sha256sum --check --strict"]
  - [chmod, "0755", /usr/local/bin/cosign]
  - [rm, --force, /usr/sbin/policy-rc.d, /tmp/caddy.deb]
  - [systemctl, daemon-reload]
  - [systemctl, enable, --now, docker]
  - [systemctl, disable, --now, caddy]
  - [systemctl, enable, --now, infinite-canvas-data.service]

final_message: "Infinite Canvas base host initialization completed in $UPTIME seconds"
